{
  "name": "medapp",
  "version": "0.1.0",
  "private": true,
  "description": "MedApp monorepo skeleton (Ionic + NestJS)",
  "scripts": {
    "dev:api": "nest start --watch --project apps/api-nest",
    "lint": "echo 'lint placeholder'",
    "test": "pnpm test:api && pnpm test:mobile",
    "test:api": "jest --config apps/api-nest/jest.config.js",
    "test:mobile": "echo 'mobile tests placeholder'",
    "prisma:migrate": "cd apps/api-nest && npx prisma migrate dev --name init"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "passport-jwt": "^4.0.1",
    "passport": "^0.6.0",
    "bcrypt": "^5.1.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "@prisma/client": "^5.0.0",
    "@nestjs/config": "^3.2.0"
  }
}
